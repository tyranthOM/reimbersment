# MongoDB Atlas connection string with the /reimb database path
MONGODB_URI=mongodb+srv://<username>:<password>@reimb.ptowlta.mongodb.net/reimb?retryWrites=true&w=majority&appName=reimb

# Secret key used for signing JWT tokens (use a random string, minimum 32 chars)
JWT_SECRET=your-secure-random-jwt-secret-key-at-least-32-chars

# Local development port
PORT=3000
